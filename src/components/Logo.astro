---
import { url } from '../lib/url';

interface Props {
  class?: string;
  compact?: boolean;
  id?: string;
}

const { class: className = '', compact = false, id = 'logo' } = Astro.props;
---

<a href={url('/')} class:list={['group inline-flex items-center gap-3', className]} aria-label="Hanu Tâmplaru' – pagina principală">
  <svg viewBox="0 0 40 40" class="h-10 w-10 shrink-0 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:rotate-[-8deg]" fill="none" aria-hidden="true">
    <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-opacity="0.4" />
    <g stroke="var(--color-oak-400)" stroke-width="1.35">
      <circle cx="20" cy="20" r="3.4" />
      <circle cx="20" cy="20" r="7.4" stroke-opacity="0.78" />
      <circle cx="20" cy="20" r="11.4" stroke-opacity="0.5" />
    </g>
    <mask id={`${id}-cut`}>
      <rect width="40" height="40" fill="#fff" />
      <path d="M7 27.6 L33 12.4" stroke="#000" stroke-width="4.2" stroke-linecap="round" />
    </mask>
    <circle cx="20" cy="20" r="15.2" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" mask={`url(#${id}-cut)`} />
    <path d="M7 27.6 L33 12.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="logo-word font-serif text-[1.35rem] tracking-[-0.02em]">
      Hanu <span class="italic-serif">Tâmplaru'</span>
    </span>
    {
      !compact && (
        <span class="mt-1.5 text-[0.54rem] font-semibold uppercase tracking-[0.3em] opacity-70">
          Mobilă la comandă · Bacău
        </span>
      )
    }
  </span>
</a>
