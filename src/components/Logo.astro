---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { url } from '../lib/url';

interface Props {
  class?: string;
  /** Fără linia „Mobilă la comandă · Bacău” de sub logo. */
  compact?: boolean;
  id?: string;
}

const { class: className = '', compact = false, id = 'logo' } = Astro.props;
---

<a
  href={url('/')}
  id={id}
  class:list={['logo group inline-flex flex-col items-start', className]}
  aria-label="Hanu Tâmplaru' – pagina principală"
>
  <Image
    src={logo}
    alt="Hanu Tâmplaru' – mobilă la comandă în județul Bacău"
    widths={[128, 256, 384]}
    sizes="128px"
    format="webp"
    loading="eager"
    class="logo-img h-12 w-auto md:h-[3.35rem]"
  />
  {
    !compact && (
      <span class="mt-2 text-[0.54rem] font-semibold uppercase tracking-[0.3em] opacity-70">
        Mobilă la comandă · Bacău
      </span>
    )
  }
</a>

<style is:global>
  .logo-img {
    transition: transform 0.7s var(--ease-out-expo);
  }
  .logo:hover .logo-img {
    transform: translateY(-2px) scale(1.02);
  }
  /* Peste fotografia din hero, logoul are nevoie de puțin contur. */
  .site-header:not(.is-scrolled) .logo-img {
    filter: drop-shadow(0 2px 12px rgb(0 0 0 / 0.55));
  }
</style>
