---
import { Plus } from '@lucide/astro';

interface Props {
  items: { q: string; a: string }[];
  light?: boolean;
  class?: string;
}

const { items, light = false, class: className = '' } = Astro.props;
---

<div class:list={['border-t', light ? 'border-bone-50/15' : 'border-walnut-900/10', className]}>
  {
    items.map((item, i) => (
      <details class:list={['group border-b', light ? 'border-bone-50/15' : 'border-walnut-900/10']} data-reveal data-delay={Math.min(i, 6) * 0.04}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 md:py-7">
          <h3 class:list={['font-serif text-[1.25rem] leading-snug tracking-[-0.01em] md:text-[1.5rem]', light ? 'text-bone-50' : 'text-walnut-900']}>
            {item.q}
          </h3>
          <span
            class:list={[
              'faq-icon mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border transition-transform duration-500 ease-[var(--ease-out-expo)]',
              light ? 'border-bone-50/25 text-oak-300' : 'border-walnut-900/15 text-oak-600',
            ]}
          >
            <Plus size={16} stroke-width={1.8} />
          </span>
        </summary>
        <p class:list={['max-w-3xl pb-7 pr-12 leading-relaxed', light ? 'text-bone-100/70' : 'text-muted']}>{item.a}</p>
      </details>
    ))
  }
</div>
