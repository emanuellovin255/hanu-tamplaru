---
import { Phone, MessageCircle, FileText } from '@lucide/astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<div class="mobile-cta fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-walnut-900/10 bg-bone-50/95 backdrop-blur-lg lg:hidden">
  <a href={site.phoneHref} class="flex flex-col items-center gap-1 py-3 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-walnut-900">
    <Phone size={18} stroke-width={1.6} class="text-oak-600" />
    Sună
  </a>
  <a
    href={site.whatsapp}
    target="_blank"
    rel="noopener"
    class="flex flex-col items-center gap-1 border-x border-walnut-900/10 py-3 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-walnut-900"
  >
    <MessageCircle size={18} stroke-width={1.6} class="text-[#25d366]" />
    WhatsApp
  </a>
  <a href={url('/contact')} class="flex flex-col items-center gap-1 bg-walnut-900 py-3 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-bone-50">
    <FileText size={18} stroke-width={1.6} class="text-oak-300" />
    Cere ofertă
  </a>
</div>

<style is:global>
  .mobile-cta {
    transform: translateY(105%);
    transition: transform 0.6s var(--ease-out-expo);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .cta-visible .mobile-cta {
    transform: none;
  }
  @media (max-width: 1023px) {
    body {
      scroll-padding-bottom: 5rem;
    }
  }
</style>
