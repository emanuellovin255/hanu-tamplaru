---
import { Phone, ArrowUpRight, ArrowRight } from '@lucide/astro';
import Logo from './Logo.astro';
import { nav, navSecondary, site, fullAddress } from '../data/site';
import { products } from '../data/products';
import { url, isActive } from '../lib/url';

const path = Astro.url.pathname;
---

<header data-header class="site-header fixed inset-x-0 top-0 z-50 text-white">
  <div class="header-bg absolute inset-0 -z-10"></div>
  <div class="container-x flex h-[var(--header-h)] items-center justify-between gap-6">
    <Logo id="logo-header" />

    <nav class="hidden items-center gap-8 text-[0.72rem] font-semibold uppercase tracking-[0.18em] lg:flex" aria-label="Meniu principal">
      <div class="group relative">
        <a
          href={url('/servicii')}
          class="link-underline flex items-center gap-1.5 py-1"
          aria-current={isActive(path, url('/servicii')) ? 'page' : undefined}
        >
          Servicii
          <svg viewBox="0 0 12 8" class="h-2 w-3 transition-transform duration-500 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M1 1l5 5 5-5" />
          </svg>
        </a>
        <div class="mega invisible absolute left-1/2 top-full w-[42rem] -translate-x-1/2 pt-5 opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="grid grid-cols-2 gap-x-6 gap-y-1 rounded-[1.5rem] border border-walnut-900/10 bg-bone-50 p-5 text-ink shadow-[0_30px_80px_-30px_rgba(29,23,19,0.45)]">
            {
              products.map((p) => (
                <a href={url(`/servicii/${p.slug}`)} class="mega-link flex items-center justify-between gap-3 rounded-xl px-4 py-3 normal-case tracking-normal transition-colors duration-300 hover:bg-bone-200">
                  <span class="font-serif text-[1.05rem] tracking-[-0.01em]">{p.name}</span>
                  <ArrowRight size={14} class="shrink-0 text-oak-600 opacity-0 transition-opacity duration-300" />
                </a>
              ))
            }
            <a href={url('/servicii')} class="mega-link col-span-2 mt-2 flex items-center justify-between gap-3 rounded-xl bg-walnut-900 px-4 py-3.5 text-bone-50 transition-colors duration-300 hover:bg-walnut-800">
              <span class="text-[0.7rem] font-bold uppercase tracking-[0.18em]">Toate serviciile</span>
              <ArrowRight size={15} />
            </a>
          </div>
        </div>
      </div>

      {
        nav.slice(1).map((item) => (
          <a href={url(item.href)} class="link-underline py-1" aria-current={isActive(path, url(item.href)) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <a href={site.phoneHref} class="hidden items-center gap-2 text-sm font-semibold tracking-wide xl:inline-flex">
        <Phone size={15} stroke-width={1.8} />
        {site.phone}
      </a>
      <a href={url('/contact')} class="btn btn-oak hidden !px-6 !py-3.5 sm:inline-flex">Cere ofertă</a>
      <button
        type="button"
        data-menu-toggle
        class="menu-toggle relative flex h-11 w-11 items-center justify-center rounded-full border border-current/30 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Deschide meniul"
      >
        <span class="menu-line absolute h-px w-5 bg-current"></span>
        <span class="menu-line absolute h-px w-5 bg-current"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  class="mobile-menu fixed inset-0 z-40 flex flex-col overflow-y-auto bg-walnut-900 text-bone-50 lg:hidden"
  aria-hidden="true"
>
  <div class="container-x flex min-h-full flex-1 flex-col justify-between pb-10 pt-[calc(var(--header-h)+1.5rem)]">
    <nav class="flex flex-col" aria-label="Meniu mobil">
      <a href={url('/')} class="mobile-link font-serif text-[2.1rem] leading-[1.25]">Acasă</a>
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            class="mobile-link font-serif text-[2.1rem] leading-[1.25]"
            aria-current={isActive(path, url(item.href)) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mobile-link mt-6 grid grid-cols-2 gap-x-5 gap-y-2 border-t border-bone-50/15 pt-6 text-sm text-bone-100/75">
        {navSecondary.map((item) => <a href={url(item.href)} class="py-1">{item.label}</a>)}
      </div>
    </nav>
    <div class="mobile-link mt-8 space-y-4 text-sm">
      <div class="hairline"></div>
      <a href={site.phoneHref} class="flex items-center gap-3 text-lg font-semibold">
        <Phone size={18} stroke-width={1.6} />
        {site.phone}
      </a>
      <p class="text-bone-100/70">{fullAddress}</p>
      <a href={url('/contact')} class="btn btn-oak w-full">
        Cere o ofertă
        <ArrowUpRight size={16} />
      </a>
    </div>
  </div>
</div>

<style is:global>
  .site-header {
    transition:
      color 0.5s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
  }
  .site-header .header-bg {
    opacity: 0;
    background: rgb(251 248 243 / 0.88);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid rgb(29 23 19 / 0.07);
    transition: opacity 0.5s var(--ease-out-expo);
  }
  .site-header.is-scrolled {
    color: var(--color-ink);
  }
  .site-header.is-scrolled .header-bg {
    opacity: 1;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .menu-open .site-header {
    color: var(--color-bone-50);
    transform: none;
  }
  .menu-open .site-header .header-bg {
    opacity: 0;
  }
  .mega {
    transition:
      opacity 0.4s var(--ease-out-expo),
      visibility 0s linear 0.4s;
  }
  .group:hover .mega,
  .group:focus-within .mega {
    transition:
      opacity 0.4s var(--ease-out-expo),
      visibility 0s;
  }
  .mega-link:hover svg {
    opacity: 1;
  }
  .menu-line {
    transition: transform 0.5s var(--ease-out-expo);
  }
  .menu-line:first-child {
    transform: translateY(-3.5px);
  }
  .menu-line:last-child {
    transform: translateY(3.5px);
  }
  .menu-open .menu-line:first-child {
    transform: rotate(45deg);
  }
  .menu-open .menu-line:last-child {
    transform: rotate(-45deg);
  }
  .mobile-menu {
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.8s var(--ease-in-out-quart),
      visibility 0s linear 0.8s;
  }
  .menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 0.8s var(--ease-in-out-quart),
      visibility 0s;
  }
  .mobile-link {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s ease,
      transform 0.8s var(--ease-out-expo);
  }
  .menu-open .mobile-link {
    opacity: 1;
    transform: none;
  }
  .mobile-link[aria-current='page'] {
    color: var(--color-oak-300);
    font-style: italic;
  }
  .menu-open .mobile-link:nth-child(1) { transition-delay: 0.24s; }
  .menu-open .mobile-link:nth-child(2) { transition-delay: 0.29s; }
  .menu-open .mobile-link:nth-child(3) { transition-delay: 0.34s; }
  .menu-open .mobile-link:nth-child(4) { transition-delay: 0.39s; }
  .menu-open .mobile-link:nth-child(5) { transition-delay: 0.44s; }
  .menu-open .mobile-link:nth-child(6) { transition-delay: 0.49s; }
  .menu-open .mobile-link:nth-child(7) { transition-delay: 0.54s; }
  .menu-open .mobile-link:nth-child(8) { transition-delay: 0.59s; }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  function setOpen(open: boolean) {
    root.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Închide meniul' : 'Deschide meniul');
    menu?.setAttribute('aria-hidden', String(!open));
    const lenis = (window as any).__lenis;
    if (lenis) open ? lenis.stop() : lenis.start();
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(!root.classList.contains('menu-open')));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root.classList.contains('menu-open')) setOpen(false);
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
