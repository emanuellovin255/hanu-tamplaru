---
import { Image } from 'astro:assets';
import { ArrowRight, Check, X } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import Marquee from '../components/Marquee.astro';
import { species, boards, finishes, hardware } from '../data/materials';
import { photo } from '../lib/photos';
import { url } from '../lib/url';
import { breadcrumbs, faqPage } from '../lib/seo';

const origin = new URL(url('/'), Astro.site).href;
const pageUrl = new URL(url('/materiale-si-finisaje'), Astro.site).href;

const pageFaq = [
  {
    q: 'Care e cel mai rezistent lemn pentru mobilă?',
    a: 'Frasinul și stejarul, ambele în jur de 1300 N pe scara Janka. Fagul e la fel de dur, dar lucrează mai mult cu umiditatea, deci îl folosim mai ales pentru structuri interioare.',
  },
  {
    q: 'Ce diferență e între PAL și MDF?',
    a: 'PAL-ul e făcut din așchii de lemn presate și se folosește pentru corpuri — e stabil și ieftin. MDF-ul e din fibre fine, complet omogen, și se folosește pentru fronturi, pentru că se poate freza și vopsi în orice culoare.',
  },
  {
    q: 'Ulei sau lac pe o masă de bucătărie?',
    a: 'Lac mat, dacă masa se folosește zilnic și există copii în casă — rezistă mult mai bine la pete. Ulei, dacă masa se folosește la ocazii și vreți un aspect cât mai natural, reparabil local.',
  },
  {
    q: 'Ce feronerie montați?',
    a: 'Blum sau Hettich, cu amortizare pe închidere. Marca se scrie în ofertă, ca să puteți compara corect cu alte propuneri.',
  },
];

const schemas = [
  breadcrumbs([
    { name: 'Acasă', url: origin },
    { name: 'Materiale și finisaje', url: pageUrl },
  ]),
  faqPage(pageFaq),
];
---

<BaseLayout
  title="Materiale și finisaje pentru mobilă"
  description="Esențele de lemn, plăcile și finisajele pe care le folosim: stejar, frasin, nuc, cireș, PAL, MDF, ulei, ceară și lac. Cu ce diferă și unde merită fiecare."
  image={photo('stock/texturi/02')}
  schemas={schemas}
>
  <PageHero
    eyebrow="Materiale"
    title='Din ce facem <em class="italic-serif text-oak-300">mobila</em>'
    text="Șase esențe de lemn masiv, cinci tipuri de plăci, cinci finisaje. Mai jos e, pe scurt, tot ce trebuie știut ca să alegeți în cunoștință de cauză."
    image="stock/texturi/02"
    crumbs={[{ name: 'Acasă', href: url('/') }, { name: 'Materiale și finisaje' }]}
  />

  <!-- ESENȚE -->
  <section class="bg-bone-100 py-20 md:py-28">
    <div class="container-x">
      <SectionHeading
        eyebrow="Esențe de lemn masiv"
        title='Șase feluri de <em class="italic-serif">lemn</em>'
        text="Duritatea o dăm pe scara Janka — forța necesară ca să înfigi o bilă de oțel pe jumătate în lemn. E cel mai bun indicator practic pentru cât de ușor se zgârie o suprafață."
        size="md"
      />
      <div class="mt-16 grid gap-px overflow-hidden rounded-[1.5rem] bg-walnut-900/10 md:grid-cols-2 lg:grid-cols-3">
        {
          species.map((s, i) => (
            <article class="bg-bone-100 p-8 md:p-9" data-reveal data-delay={Math.min(i, 5) * 0.05}>
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-[1.8rem] text-walnut-900">{s.name}</h3>
                <p class="shrink-0 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-oak-600">{s.hardness}</p>
              </div>
              <p class="mt-1 text-xs italic text-muted">{s.latin}</p>
              <p class="mt-5 text-sm leading-relaxed text-muted">{s.text}</p>
              <p class="mt-5 text-[0.62rem] font-bold uppercase tracking-[0.18em] text-walnut-800">Culoare</p>
              <p class="mt-1 text-sm text-muted">{s.tone}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {s.bestFor.map((b) => (
                  <li class="rounded-full border border-walnut-900/15 px-3 py-1 text-[0.72rem] text-walnut-900">{b}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TEXTURI -->
  <section class="relative h-[60svh] min-h-[380px] overflow-hidden">
    <div class="absolute inset-x-0 -top-[12%] h-[124%]" data-parallax="8">
      <Image
        src={photo('stock/texturi/03')}
        alt="Fibră de lemn masiv, cu noduri și desen pronunțat"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="img-cover"
      />
    </div>
    <div class="absolute inset-0 bg-walnut-950/45"></div>
    <div class="container-x relative flex h-full items-center">
      <p class="max-w-3xl font-serif text-[clamp(1.5rem,3.4vw,2.9rem)] leading-tight text-white" data-reveal>
        Lemnul pentru interior intră în atelier la 8–10% umiditate. Verificăm cu umidometrul înainte de
        croire — nu după.
      </p>
    </div>
  </section>

  <!-- PLĂCI -->
  <section class="bg-bone-200/60 py-20 md:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Plăci" title='PAL, MDF și <em class="italic-serif">restul</em>' size="md" />
      <div class="mt-16 space-y-px overflow-hidden rounded-[1.5rem] bg-walnut-900/10">
        {
          boards.map((b, i) => (
            <article class="grid gap-6 bg-bone-100 p-8 md:grid-cols-12 md:p-10" data-reveal data-delay={Math.min(i, 5) * 0.04}>
              <div class="md:col-span-4">
                <h3 class="font-serif text-2xl text-walnut-900">{b.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted">{b.text}</p>
              </div>
              <div class="md:col-span-4">
                <p class="text-[0.6rem] font-bold uppercase tracking-[0.18em] text-oak-600">Avantaje</p>
                <ul class="mt-4 space-y-2">
                  {b.pros.map((p) => (
                    <li class="flex gap-2.5 text-sm text-walnut-900">
                      <Check size={14} stroke-width={2.4} class="mt-1 shrink-0 text-[color:var(--color-sage-500)]" /> {p}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="md:col-span-4">
                <p class="text-[0.6rem] font-bold uppercase tracking-[0.18em] text-muted">Limitări</p>
                <ul class="mt-4 space-y-2">
                  {b.cons.map((c) => (
                    <li class="flex gap-2.5 text-sm text-muted">
                      <X size={14} stroke-width={2.4} class="mt-1 shrink-0 text-[color:var(--color-rust-500)]" /> {c}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-10 text-sm text-muted" data-reveal>
        Comparație detaliată în ghidul
        <a href={url('/ghiduri/pal-mdf-sau-lemn-masiv')} class="link-underline font-semibold text-walnut-900">
          PAL, MDF sau lemn masiv
        </a>.
      </p>
    </div>
  </section>

  <Marquee words={['Ulei', 'Ceară', 'Lac', 'Lazură']} class="bg-bone-100 text-walnut-800" />

  <!-- FINISAJE -->
  <section class="bg-bone-100 pb-20 md:pb-28">
    <div class="container-x">
      <SectionHeading
        eyebrow="Finisaje"
        title='Ce punem peste <em class="italic-serif">lemn</em>'
        text="Finisajul decide cât rezistă suprafața și cât de ușor se repară. Amândouă contează, dar rareori în aceeași direcție."
        size="md"
      />
      <div class="mt-16 grid gap-px overflow-hidden rounded-[1.5rem] bg-walnut-900/10 md:grid-cols-2 lg:grid-cols-3">
        {
          finishes.map((f, i) => (
            <article class="bg-bone-100 p-8" data-reveal data-delay={Math.min(i, 5) * 0.05}>
              <h3 class="font-serif text-2xl text-walnut-900">{f.name}</h3>
              <p class="mt-4 text-sm leading-relaxed text-muted">{f.text}</p>
              <div class="mt-6 border-t border-walnut-900/10 pt-4">
                <p class="text-[0.6rem] font-bold uppercase tracking-[0.18em] text-oak-600">Întreținere</p>
                <p class="mt-2 text-sm text-muted">{f.care}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-10 text-sm text-muted" data-reveal>
        Comparație detaliată în ghidul
        <a href={url('/ghiduri/finisaje-pentru-lemn-lac-ulei-sau-ceara')} class="link-underline font-semibold text-walnut-900">
          lac, ulei sau ceară
        </a>.
      </p>
    </div>
  </section>

  <!-- FERONERIE -->
  <section class="grain relative overflow-hidden bg-walnut-900 py-20 text-bone-50 md:py-28">
    <div class="container-x">
      <SectionHeading
        eyebrow="Feronerie"
        title='Partea care se <em class="italic-serif text-oak-300">mișcă</em>'
        text="Feroneria e singura componentă a mobilei care se folosește de zeci de ori pe zi. Diferența dintre o balama bună și una ieftină nu se vede în prima lună, ci în anul al treilea."
        light
        size="md"
      />
      <div class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          hardware.map((h, i) => (
            <div class="rounded-[1.25rem] border border-bone-50/12 p-7" data-reveal data-delay={Math.min(i, 5) * 0.05}>
              <h3 class="font-serif text-xl leading-tight">{h.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-bone-100/70">{h.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-bone-100 py-20 md:py-28">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="Întrebări" title='Despre <em class="italic-serif">materiale</em>' size="md" />
        <a href={url('/ghiduri')} class="arrow-link mt-8 text-walnut-800" data-reveal>Ghiduri detaliate <ArrowRight size={16} /></a>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <dl class="border-t border-walnut-900/10">
          {
            pageFaq.map((f, i) => (
              <div class="border-b border-walnut-900/10 py-7" data-reveal data-delay={i * 0.04}>
                <dt class="font-serif text-[1.3rem] leading-snug text-walnut-900">{f.q}</dt>
                <dd class="mt-3 max-w-2xl leading-relaxed text-muted">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
