---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTASection from '../../components/CTASection.astro';
import StatsBand from '../../components/StatsBand.astro';
import { products } from '../../data/products';
import { usps } from '../../data/site';
import { photo } from '../../lib/photos';
import { url } from '../../lib/url';
import { itemList, breadcrumbs } from '../../lib/seo';

const origin = new URL(url('/'), Astro.site).href;
const pageUrl = new URL(url('/servicii'), Astro.site).href;

const schemas = [
  itemList(
    'Servicii de tâmplărie și mobilă la comandă',
    products.map((p) => ({ name: p.name, url: new URL(url(`/servicii/${p.slug}`), Astro.site).href })),
  ),
  breadcrumbs([
    { name: 'Acasă', url: origin },
    { name: 'Servicii', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Servicii — mobilă la comandă în Bacău"
  description="Toate serviciile Hanu Tâmplaru': bucătării, dressinguri, living, paturi, uși, mese, birouri și scaune, la comandă în județul Bacău."
  image={photo('stock/atmosfera/03')}
  schemas={schemas}
>
  <PageHero
    eyebrow="Servicii"
    title='Nouă categorii, un <em class="italic-serif text-oak-300">singur atelier</em>'
    text="Facem tot ce intră într-o casă din lemn și din plăci. Fiecare categorie are pagina ei, cu materiale, opțiuni, termene și întrebări frecvente."
    image="stock/atmosfera/03"
    crumbs={[{ name: 'Acasă', href: url('/') }, { name: 'Servicii' }]}
  />

  <section class="bg-bone-100 py-20 md:py-28">
    <div class="container-x">
      <div class="max-w-4xl">
        <p class="font-serif text-[clamp(1.5rem,2.8vw,2.4rem)] leading-snug text-walnut-900" data-reveal>
          Avantajul unui atelier care face de toate: bucătăria, dressingul și ușile ies din aceeași mână,
          în aceleași nuanțe, cu aceeași feronerie. Nu mai combinați trei furnizori și trei standarde.
        </p>
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p, i) => <ProductCard product={p} index={i} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <StatsBand class="pb-8" />

  <section class="bg-bone-100 py-20 md:py-28">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Ce primiți, indiferent de produs"
          title='Patru lucruri care nu se <em class="italic-serif">negociază</em>'
          size="md"
        />
        <div class="mt-10 flex flex-wrap gap-4" data-reveal>
          <a href={url('/proces')} class="btn btn-dark">Cum lucrăm <ArrowRight size={16} /></a>
          <a href={url('/materiale-si-finisaje')} class="btn btn-ghost-dark">Materiale</a>
        </div>
      </div>
      <div class="lg:col-span-7">
        <ul class="grid gap-px overflow-hidden rounded-[1.5rem] bg-walnut-900/10 sm:grid-cols-2">
          {
            usps.map((u, i) => (
              <li class="bg-bone-100 p-8" data-reveal data-delay={i * 0.05}>
                <p class="font-serif text-xl leading-tight text-walnut-900">{u.title}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted">{u.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
